# Supabase PostgreSQL connection
# Replace YOUR_REF, YOUR_REGION, and YOUR_PASSWORD with your Supabase project values.
# Password must be URL-encoded if it contains special characters (e.g. @ -> %40).
# Use the Session-mode pooler (port 5432) for full Prisma compatibility.
#
# Find these in: Supabase Dashboard → Project Settings → Database → Connection string
#
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"
